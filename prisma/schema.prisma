generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model usuario {
  usu_id    Int  @id @default(autoincrement())
  usu_nome  String  @db.VarChar(40)
  usu_email String  @unique @db.VarChar(255)
  usu_senha String @db.VarChar(255)
  usu_cpf   String  @unique @db.VarChar(14) 
  usu_telefone String? @db.VarChar(15)
  usu_data_nasc DateTime @db.Date
  usu_avaliacao String? @db.VarChar(500)

  liders        lider[]
  mensalidades  mensalidade[]
  participantes participante[]

  @@map("usuario")
}

model mensalidade {
  men_id          Int @id @default(autoincrement())
  men_status_pag  String @db.VarChar(20) 
  men_data_lan    DateTime @db.Date
  men_valor_pago  Decimal @db.Decimal(10, 2)
  men_data_ven    DateTime @db.Date
  men_valor       Decimal @db.Decimal(10, 2)
  men_data_pag    DateTime @db.Date

  usu_id Int
  usuario usuario @relation(fields: [usu_id], references: [usu_id])

  @@map("mensalidade")
}

model lider {
  lid_id  Int @id @default(autoincrement())

  usu_id  Int
  usuario usuario @relation(fields: [usu_id], references: [usu_id]) 

  grupos grupo[]

  @@map("lider")
}

model grupo{
  gru_id       Int @id @default(autoincrement())
  gru_num_part Int 

  lid_id       Int
  cat_id       Int
  lider lider         @relation(fields: [lid_id], references: [lid_id])
  categoria categoria @relation(fields: [cat_id], references: [cat_id])
  
  participantes participante[]
  
  @@map("grupo")
}

model participante {
  usu_id   Int
  gru_id   Int
  usuario usuario @relation(fields: [usu_id], references: [usu_id]) 
  grupo grupo     @relation(fields: [gru_id], references:[gru_id])
  
  @@id([usu_id, gru_id])
  @@map("participante")
}

model categoria {
  cat_id   Int @id @default(autoincrement())
  cat_nome String @db.VarChar(50)


  grupos      grupo[]
  streams     stream[]
  viagens     viagem[]
  domesticos  domestico[]

  @@map("categoria")
}

model stream {
 cat_id    Int @id
 str_valor Decimal @db.Decimal(10, 2)

 categoria categoria @relation(fields: [cat_id], references: [cat_id])
 @@map("stream")
 }

model viagem {
 cat_id          Int @id
 via_partida     String @db.VarChar(50)
 via_destino     String @db.VarChar(50)
 via_data_inicio DateTime @db.Date
 via_data_fim    DateTime @db.Date

 categoria categoria @relation(fields: [cat_id], references: [cat_id])
 @@map("viagem")
}

model domestico {
 cat_id       Int @id
 dom_aluguel  Decimal @db.Decimal(10,2)
 dom_Luz      Decimal @db.Decimal(10,2)
 dom_agua     Decimal @db.Decimal(10,2)
 dom_internet Decimal @db.Decimal(10,2)

 categoria categoria @relation(fields: [cat_id], references: [cat_id])
 @@map("domestico")
}
